# Lung Cancer Diagnostic System Environment Configuration
# Copy this file to .env and update values for your environment

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Database Configuration (Optional - for future data persistence)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lung_cancer_db
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Model Configuration
CT_MODEL_PATH=models/lung_cancer_cnn_model.keras
RISK_MODEL_PATH=models/risk_assessment_model.h5
SCALER_PATH=models/scaler.pkl

# Security Configuration
JWT_SECRET_KEY=jwt-secret-key
BCRYPT_ROUNDS=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging Configuration
LOG_LEVEL=INFO

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg

# Email Configuration (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Monitoring Configuration (Optional)
SENTRY_DSN=your-sentry-dsn-here

# External API Keys (Optional)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key